; Engine configuration file.
; Chapter 1 standalone development project.
config_version=5

[application]

config/name="盐月旅馆 · 第一章（独立开发）"
run/main_scene="res://scenes/ch1/ch1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0784314, 0.0980392, 0.0901961, 1)
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
WindowManager="*res://scripts/autoload/window_manager.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

theme/custom="res://assets/theme/game_theme.tres"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
